  "version": "0.1.0",
  "description": "YouMorph Fitness - Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit"
